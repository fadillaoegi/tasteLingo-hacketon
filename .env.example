# Copy to .env (gitignored). Never commit real keys.
POSTGRES_USER=tastelingo
POSTGRES_PASSWORD=tastelingo_local
POSTGRES_DB=tastelingo
DATABASE_URL=postgres://tastelingo:tastelingo_local@127.0.0.1:8100/tastelingo?sslmode=disable
STORE_MODE=postgres
API_ADDR=127.0.0.1:8104

# mock = synthetic data labelled "(mock)"; live = real Qloo hackathon API
QLOO_MODE=mock
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_API_KEY=

# mock = scripted planner; gemini = real model with function calling
LLM_MODE=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Ordered fallbacks. Limited models cool down for at least 60s.
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.6-flash
# Discover additional compatible Gemini text models if configured models are unavailable.
GEMINI_AUTO_DISCOVER=true

# Public deployment protection (the production Dockerfile enables these).
RATE_LIMIT=false
TRUST_PROXY=false
AGENT_LIMIT_PER_IP=20
AGENT_LIMIT_GLOBAL=300
LIGHT_LIMIT_PER_IP=200
LIGHT_LIMIT_GLOBAL=3000
# Serve the built frontend from the API (set automatically in the Docker image).
STATIC_DIR=
